# ---------------------------------------------------------------- detection cache
#
# ami_detect's process-tree walk costs ~1.5s on a busy machine, and agents call
# pgrep a lot. The answer is stable for the life of a session, so memoise it
# against the session's ancestry. Agents run every tool call in a fresh
# `bash -c`, so the key skips the shells nearest us (otherwise every call
# misses) and includes the environment's variable names instead, which is
# where env-based detection looks.

aap_session_key() {
    local pid=$PPID depth=0 chain="" line pp cm skipping=1
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$depth" -lt 10 ]; do
        line=$(ps -p "$pid" -o ppid=,comm= 2>/dev/null) || break
        read -r pp cm <<EOF
$line
EOF
        if [ "$skipping" = 1 ]; then
            cm="${cm##*/}"
            case "${cm#-}" in
                sh|bash|zsh|dash|ksh|fish|elvish|nu|tcsh|csh) ;;
                *) skipping=0 ;;
            esac
        fi
        [ "$skipping" = 0 ] && chain="$chain:$pid"
        pid="$pp"
        depth=$((depth + 1))
    done
    { echo "${chain#:}"; env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort; } \
        | cksum | cut -d' ' -f1
}

aap_agent() {
    local key cache agent
    # Honour the opt-out before consulting the cache, or a memoised "claude"
    # would outlive an explicit AMI_PASSTHROUGH.
    if [ "${AMI_PASSTHROUGH:-}" = "true" ]; then
        printf 'none'
        return 0
    fi
    key=$(aap_session_key)
    cache="$AAP_CACHE/agent-$key"
    if [ -r "$cache" ]; then
        cat "$cache"
        return 0
    fi
    agent=$(ami_detect 2>/dev/null || echo none)
    mkdir -p "$AAP_CACHE" 2>/dev/null
    printf '%s' "$agent" > "$cache" 2>/dev/null
    printf '%s' "$agent"
}

# ---------------------------------------------------------------- signals

# Normalise a signal spec to what /bin/kill accepts: a number, or an uppercase
# name without the SIG prefix. Prints nothing and fails if it is not a signal.
aap_signal() {
    local s
    s=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
    s="${s#SIG}"
    case "$s" in
        ''|*[!0-9A-Z]*) return 1 ;;
    esac
    case "$s" in
        [0-9]|[12][0-9]|3[01]) printf '%s' "$s"; return 0 ;;
        CLD)  printf 'CHLD'; return 0 ;;
        POLL) printf 'IO';   return 0 ;;
        IOT)  printf 'ABRT'; return 0 ;;
        HUP|INT|QUIT|ILL|TRAP|ABRT|EMT|FPE|KILL|BUS|SEGV|SYS|PIPE|ALRM|TERM|\
        URG|STOP|TSTP|CONT|CHLD|TTIN|TTOU|IO|XCPU|XFSZ|VTALRM|PROF|WINCH|INFO|\
        USR1|USR2)
            printf '%s' "$s"; return 0 ;;
    esac
    return 1
}

# ---------------------------------------------------------------- argv parsing
#
# GNU procps semantics: options may appear anywhere before `--`, a single
# pattern is allowed, and pkill recognises -<signal> in any position.

aap_reset() {
    O_FULL=0 O_NEWEST=0 O_OLDEST=0 O_EXACT=0 O_ICASE=0 O_INVERSE=0
    O_COUNT=0 O_LISTNAME=0 O_LISTFULL=0 O_ECHO=0 O_QUIET=0 O_LOCK=0
    O_DELIM=$'\n' O_HELP=0 O_VERSION=0
    O_SIGNAL="" CRIT=() PATTERNS=() REORDERED=0 PARSE_ERR=""
}

aap_unsupported() {
    PARSE_ERR="option '$1' is not available on macOS (no /proc); see 'ai-aligned-pkill help'"
}

# Apply one option. $1 = tool, $2 = canonical letter, $3 = value (if any).
aap_apply() {
    local tool="$1" opt="$2" val="$3"
    case "$opt" in
        f) O_FULL=1 ;;
        n) O_NEWEST=1 ;;
        o) O_OLDEST=1 ;;
        x) O_EXACT=1 ;;
        i) O_ICASE=1 ;;
        v) O_INVERSE=1 ;;
        c) O_COUNT=1 ;;
        q) O_QUIET=1 ;;
        L) O_LOCK=1 ;;
        A) : ;;  # --ignore-ancestors: BSD already excludes them, always.
        l) if [ "$tool" = pkill ]; then O_ECHO=1; else O_LISTNAME=1; fi ;;
        a) if [ "$tool" = pkill ]; then PARSE_ERR="invalid option -- 'a'"; else O_LISTFULL=1; fi ;;
        e) if [ "$tool" = pkill ]; then O_ECHO=1; else PARSE_ERR="invalid option -- 'e'"; fi ;;
        d) if [ "$tool" = pgrep ]; then O_DELIM="$val"; else PARSE_ERR="invalid option -- 'd'"; fi ;;
        u|U|G|g|P|t|F) CRIT+=("-$opt" "$val") ;;
        S) O_SIGNAL=$(aap_signal "$val") || PARSE_ERR="unknown signal '$val'" ;;
        h) O_HELP=1 ;;
        V) O_VERSION=1 ;;
        *) PARSE_ERR="invalid option -- '$opt'" ;;
    esac
}

# Does short option $1 take a value?
aap_takes_value() {
    case "$1" in u|U|G|g|P|t|F|d) return 0 ;; esac
    return 1
}

aap_parse() {
    local tool="$1"; shift
    aap_reset
    local args=("$@") n=$# i=0 a name val opt j c rest end=0
    while [ "$i" -lt "$n" ]; do
        a="${args[$i]}"
        i=$((i + 1))
        if [ "$end" = 1 ]; then PATTERNS+=("$a"); continue; fi
        case "$a" in
            --)
                end=1 ;;
            --*)
                [ ${#PATTERNS[@]} -gt 0 ] && REORDERED=1
                name="${a%%=*}" val="" opt=""
                case "$a" in *=*) val="${a#*=}" ;; esac
                case "$name" in
                    --full) opt=f ;; --newest) opt=n ;; --oldest) opt=o ;;
                    --exact) opt=x ;; --ignore-case) opt=i ;; --inverse) opt=v ;;
                    --count) opt=c ;; --list-name) opt=l ;; --list-full) opt=a ;;
                    --echo) opt=e ;; --ignore-ancestors) opt=A ;;
                    --logpidfile) opt=L ;; --help) opt=h ;; --version) opt=V ;;
                    --delimiter) opt=d ;; --euid) opt=u ;; --uid) opt=U ;;
                    --group) opt=G ;; --pgroup) opt=g ;; --parent) opt=P ;;
                    --terminal) opt=t ;; --pidfile) opt=F ;; --signal) opt=S ;;
                    --session|--older|--runstates|--ns|--nslist|--cgroup|--env|\
                    --lightweight|--require-handler|--queue)
                        aap_unsupported "$name"; return 2 ;;
                    *)  PARSE_ERR="unrecognized option '$name'"; return 2 ;;
                esac
                case "$opt" in
                    d|u|U|G|g|P|t|F|S)
                        if [ "$a" = "$name" ]; then
                            [ "$i" -lt "$n" ] || { PARSE_ERR="option '$name' requires an argument"; return 2; }
                            val="${args[$i]}"; i=$((i + 1))
                        fi ;;
                esac
                aap_apply "$tool" "$opt" "$val"
                [ -n "$PARSE_ERR" ] && return 2 ;;
            -?*)
                [ ${#PATTERNS[@]} -gt 0 ] && REORDERED=1
                rest="${a#-}"
                # pkill: -SIGNAL in any position, as GNU does. A lowercase
                # name made only of flag letters stays a cluster, so `-io` is
                # "-i -o" rather than SIGIO; `-term` and `-int` are signals.
                if [ "$tool" = pkill ] && [ -z "$O_SIGNAL" ] && aap_signal "$rest" >/dev/null; then
                    case "$rest" in
                        *[!fnoxivclqLAae]*|[0-9]*|*[A-Z]*)
                            O_SIGNAL=$(aap_signal "$rest"); continue ;;
                    esac
                fi
                j=0
                while [ "$j" -lt ${#rest} ]; do
                    c="${rest:$j:1}"
                    j=$((j + 1))
                    case "$c" in
                        s|O|r|w|H|Q) aap_unsupported "-$c"; return 2 ;;
                    esac
                    if aap_takes_value "$c"; then
                        val="${rest:$j}"
                        if [ -z "$val" ]; then
                            [ "$i" -lt "$n" ] || { PARSE_ERR="option requires an argument -- '$c'"; return 2; }
                            val="${args[$i]}"; i=$((i + 1))
                        fi
                        aap_apply "$tool" "$c" "$val"
                        j=${#rest}
                    else
                        aap_apply "$tool" "$c" ""
                    fi
                    [ -n "$PARSE_ERR" ] && return 2
                done ;;
            *)
                PATTERNS+=("$a") ;;
        esac
    done

    if [ ${#PATTERNS[@]} -gt 1 ]; then
        PARSE_ERR="only one pattern can be provided (got ${#PATTERNS[@]}: $(printf "'%s' " "${PATTERNS[@]}"))"
        return 2
    fi
    if [ ${#PATTERNS[@]} -eq 0 ] && [ ${#CRIT[@]} -eq 0 ] && [ "$O_HELP$O_VERSION" = "00" ]; then
        PARSE_ERR="no matching criteria specified"
        return 2
    fi
    if [ "$O_NEWEST" = 1 ] && [ "$O_OLDEST" = 1 ]; then
        PARSE_ERR="-n and -o are mutually exclusive"
        return 2
    fi
    [ -z "$O_SIGNAL" ] && O_SIGNAL=TERM
    return 0
}

# BSD argv for the real pgrep, options strictly before the pattern.
aap_bsd_args() {
    BSD=()
    [ "$O_FULL" = 1 ]    && BSD+=(-f)
    [ "$O_NEWEST" = 1 ]  && BSD+=(-n)
    [ "$O_OLDEST" = 1 ]  && BSD+=(-o)
    [ "$O_EXACT" = 1 ]   && BSD+=(-x)
    [ "$O_ICASE" = 1 ]   && BSD+=(-i)
    [ "$O_INVERSE" = 1 ] && BSD+=(-v)
    [ "$O_LOCK" = 1 ]    && BSD+=(-L)
    [ ${#CRIT[@]} -gt 0 ] && BSD+=("${CRIT[@]}")
    [ ${#PATTERNS[@]} -gt 0 ] && BSD+=(-- "${PATTERNS[0]}")
    return 0
}

# ---------------------------------------------------------------- vetting
#
# Every candidate's ancestry is walked upward until something decides it:
#
#   descends from this agent's harness      -> ours, may be signalled
#   passes another agent's harness          -> refused
#   passes a login/login shell/sshd/tmux    -> refused (a terminal session)
#   is, or descends from, an app bundle or
#     a system binary                       -> refused
#   joins this command's own ancestry above
#     the harness (e.g. sibling threads)    -> refused
#   tops out at a child of launchd that
#     leads its own process group           -> refused (a launchd job/service)
#   tops out at any other child of launchd  -> orphan (e.g. a `cmd &` server
#                                              outliving its tool shell), ok
#
# Prints one line per PID: pid<TAB>ok|refuse<TAB>reason<TAB>name<TAB>args

aap_vet() {
    local self="$1"; shift
    local tmp
    tmp=$(mktemp -t aap-ps) || return 3
    /bin/ps -axww -o pid=,ppid=,pgid=,comm= > "$tmp.comm" 2>/dev/null
    /bin/ps -axww -o pid=,args= > "$tmp.args" 2>/dev/null
    local prefixes="/Applications/:/System/:/usr/libexec/:/usr/sbin/:/sbin/:/Library/Apple/:$HOME/Applications/"
    [ -n "$AAP_PROTECT_EXTRA" ] && prefixes="$prefixes:$AAP_PROTECT_EXTRA"
    awk -v self="$self" -v targets="$*" -v harn="$AAP_HARNESSES" \
        -v prefixes="$prefixes" '
    function base(s,   n, p) { n = split(s, p, "/"); return p[n] }
    function is_harness(x,   b, t, n, k, bb) {
        b = tolower(base(comm[x])); sub(/^-/, "", b)
        if (b in H) return 1
        if (b ~ /^(node|bun|deno|python[0-9.]*)$/) {
            n = split(args[x], t, " ")
            for (k = 2; k <= n; k++) {
                if (substr(t[k], 1, 1) == "-") continue
                bb = tolower(base(t[k])); sub(/\.(m?js|cjs|ts|py)$/, "", bb)
                return (bb in H)
            }
        }
        return 0
    }
    function is_login(x,   b) {
        if (substr(comm[x], 1, 1) == "-") return 1
        b = base(comm[x])
        return (b == "login" || b == "sshd" || b == "tmux" || b == "screen" || \
                b == "zellij" || b == "mosh-server")
    }
    function protpath(x,   k, a, app) {
        a = args[x]
        for (k = 1; k <= np; k++) {
            if (P[k] != "" && index(a, P[k]) == 1) {
                if (match(a, /[^\/]+\.app\//)) {
                    app = substr(a, RSTART, RLENGTH - 1)
                    return app
                }
                return "a system process (" P[k] ")"
            }
        }
        return ""
    }
    function who(x) { return base(comm[x]) " (pid " x ")" }
    function verdict(p,   x, d, r) {
        if (!(p in ppid)) return "ok\tgone"
        if (p in chain) return "refuse\tis an ancestor of this command"
        # Anything this session started is fair game, whatever its binary.
        x = ppid[p]
        for (d = 0; d < 128 && x > 1 && (x in ppid); d++) {
            if (x == root) return "ok\tdescends from this agent session"
            x = ppid[x]
        }
        x = p
        for (d = 0; d < 128; d++) {
            if (is_harness(x)) return "refuse\tbelongs to another agent session: " who(x)
            if (is_login(x)) return "refuse\tbelongs to a terminal session: " who(x)
            r = protpath(x)
            if (r != "") return "refuse\t" (x == p ? "is part of " r : "is part of " r ", via " who(x))
            if (x in chain) return "refuse\tis outside this agent session (they meet at " who(x) ")"
            if (ppid[x] <= 1 || !(ppid[x] in ppid)) {
                if (pgid[x] == x)
                    return "refuse\t" (x == p ? "is" : "descends from") " a launchd job, not an orphan of this session: " who(x)
                return "ok\torphaned (reparented to launchd)"
            }
            x = ppid[x]
        }
        return "refuse\tancestry too deep to vet"
    }
    FNR == NR {
        pid = $1; pp = $2; pgid[pid] = $3
        sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+[0-9]+[ \t]+/, "")
        ppid[pid] = pp; comm[pid] = $0
        next
    }
    {
        pid = $1
        sub(/^[ \t]*[0-9]+[ \t]+/, "")
        args[pid] = $0
    }
    END {
        nh = split(harn, hh, " "); for (k = 1; k <= nh; k++) H[tolower(hh[k])] = 1
        np = split(prefixes, P, ":")
        # This command'"'"'s ancestry, and the nearest harness in it.
        root = ""; c = self
        for (d = 0; d < 128 && c > 1 && (c in ppid); d++) {
            chain[c] = 1
            if (root == "" && c != self && is_harness(c)) root = c
            c = ppid[c]
        }
        # No recognisable harness (detected from the environment only): the
        # session is everything below the nearest terminal/app/launchd boundary.
        if (root == "") {
            root = self; c = ppid[self]
            while (c > 1 && (c in ppid) && !is_login(c) && protpath(c) == "") {
                root = c; c = ppid[c]
            }
        }
        nt = split(targets, T, " ")
        for (k = 1; k <= nt; k++) {
            p = T[k]
            a = args[p]; if (length(a) > 160) a = substr(a, 1, 157) "..."
            printf "%s\t%s\t%s\t%s\n", p, verdict(p), base(comm[p]), a
        }
    }' "$tmp.comm" "$tmp.args"
    local rc=$?
    rm -f "$tmp" "$tmp.comm" "$tmp.args"
    return $rc
}

# ---------------------------------------------------------------- logging

aap_log() {
    local agent="$1" tool="$2" outcome="$3" pids="$4"; shift 4
    local argv
    argv=$(printf '%s ' "$@" | tr '\t\n' '  ')
    mkdir -p "$AAP_HOME" 2>/dev/null || return 0
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
        "$agent" "$tool" "$outcome" "$PWD" "${argv% }" "$pids" >> "$AAP_LOG" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------- shims

aap_usage_error() {
    local tool="$1"
    aap_notice "$tool: $PARSE_ERR"
    case "$PARSE_ERR" in
        "only one pattern"*)
            aap_notice "  options may come before or after the pattern; to match a pattern that"
            aap_notice "  starts with '-', put it after '--'. Combine alternatives with '|' in one"
            aap_notice "  extended regex, e.g. $tool -f 'foo|bar'" ;;
    esac
    return 2
}

aap_reorder_note() {
    [ "$REORDERED" = 1 ] || return 0
    aap_notice "note: read options after the pattern GNU-style; macOS $1 would have treated them as extra patterns"
}

aap_shim_pgrep() {
    local agent="$1"; shift
    aap_parse pgrep "$@" || { aap_usage_error pgrep; return 2; }
    [ "$O_HELP" = 1 ] && { aap_help; return 0; }
    [ "$O_VERSION" = 1 ] && { echo "pgrep from ai-aligned-pkill $VERSION (GNU-compatible front end for $AAP_REAL_PGREP)"; return 0; }
    aap_reorder_note pgrep
    aap_bsd_args
    local pids rc
    pids=$("$AAP_REAL_PGREP" "${BSD[@]}")
    rc=$?
    [ "$rc" -gt 1 ] && return "$rc"
    if [ "$O_COUNT" = 1 ]; then
        printf '%s\n' "$pids" | grep -c . 
        [ -n "$pids" ]; return $?
    fi
    [ -z "$pids" ] && return 1
    [ "$O_QUIET" = 1 ] && return 0
    local p line out="" sep="" delim=$'\n'
    [ "$O_LISTFULL$O_LISTNAME" = "00" ] && delim="$O_DELIM"
    for p in $pids; do
        if [ "$O_LISTFULL" = 1 ]; then
            line=$(/bin/ps -ww -o args= -p "$p" 2>/dev/null) || continue
            out="$out$sep$p $line"
        elif [ "$O_LISTNAME" = 1 ]; then
            line=$(/bin/ps -o comm= -p "$p" 2>/dev/null) || continue
            out="$out$sep$p ${line##*/}"
        else
            out="$out$sep$p"
        fi
        sep="$delim"
    done
    printf '%s\n' "$out"
    return 0
}

# Shared by the pkill shim and `ai-aligned-pkill check`. $1 = 1 for a dry run.
aap_shim_pkill() {
    local dry="$1" agent="$2"; shift 2
    aap_parse pkill "$@" || { aap_usage_error pkill; return 2; }
    [ "$O_HELP" = 1 ] && { aap_help; return 0; }
    [ "$O_VERSION" = 1 ] && { echo "pkill from ai-aligned-pkill $VERSION (GNU-compatible front end for $AAP_REAL_PKILL)"; return 0; }
    aap_reorder_note pkill
    if [ "$O_INVERSE" = 1 ]; then
        aap_notice "pkill: refusing -v/--inverse: it signals every process that does NOT match."
        aap_notice "  List what you mean with pgrep, then kill those PIDs explicitly."
        aap_log "$agent" pkill refused-inverse "" "$@"
        return 3
    fi
    aap_bsd_args
    local pids rc
    pids=$("$AAP_REAL_PGREP" "${BSD[@]}")
    rc=$?
    [ "$rc" -gt 1 ] && return "$rc"
    if [ -z "$pids" ]; then
        [ "$O_COUNT" = 1 ] && echo 0
        [ "$dry" = 1 ] && aap_notice "check: no processes match"
        return 1
    fi

    local vetted count refused
    # shellcheck disable=SC2086
    vetted=$(aap_vet "$$" $pids) || { aap_notice "pkill: could not vet matches; nothing was signalled"; return 3; }
    count=$(printf '%s\n' "$vetted" | grep -c .)
    refused=$(printf '%s\n' "$vetted" | awk -F'\t' '$2 == "refuse"' | grep -c .)
    aap_debug "matched $count, refused $refused"

    local reason=""
    [ "$refused" -gt 0 ] && reason="$refused of the $count matching processes are outside this agent's session"
    if [ "$count" -gt "$AAP_MAX" ]; then
        [ -n "$reason" ] && reason="$reason, and "
        reason="${reason}the pattern matched $count processes (limit $AAP_MAX)"
    fi

    if [ -n "$reason" ] || [ "$dry" = 1 ]; then
        if [ -n "$reason" ]; then
            aap_notice "pkill: refused — $reason. Nothing was signalled."
        else
            aap_notice "check: would signal $count process(es) with SIG$O_SIGNAL"
        fi
        printf '%s\n' "$vetted" | awk -F'\t' -v limit=25 '
            NR <= limit { printf "  %-7s %-6s %-60s %s\n", $1, ($2 == "ok" ? "ok" : "REFUSE"), $3, $5 }
            END { if (NR > limit) printf "  ... and %d more\n", NR - limit }' >&2
        [ -z "$reason" ] && return 0
        aap_notice "  Narrow the match (-x, an anchored -f regex, -P <ppid>, -u \$USER), or better,"
        aap_notice "  signal the PID you started:  cmd & pid=\$!; ...; kill \$pid"
        [ "$refused" -gt 0 ] && aap_notice "  Processes this session did not start belong to the user; ask them first."
        # shellcheck disable=SC2086
        [ "$dry" = 1 ] || aap_log "$agent" pkill refused "$(printf '%s ' $pids)" "$@"
        return 3
    fi

    # Signal exactly what was vetted.
    local p name ok=0 failed=0 line
    while IFS=$'\t' read -r p _ _ name _; do
        [ -z "$p" ] && continue
        if /bin/kill -"$O_SIGNAL" "$p" 2>/dev/null; then
            ok=$((ok + 1))
            [ "$O_ECHO" = 1 ] && echo "$name killed (pid $p)"
        else
            failed=$((failed + 1))
            echo "pkill: killing pid $p failed: $(/bin/kill -"$O_SIGNAL" "$p" 2>&1 | sed 's/.*: //')" >&2
        fi
    done <<EOF
$vetted
EOF
    [ "$O_COUNT" = 1 ] && echo "$ok"
    aap_log "$agent" pkill "signalled:$O_SIGNAL" "$(printf '%s ' $pids)" "$@"
    [ "$ok" -gt 0 ] && return 0
    return 3
}

# ---------------------------------------------------------------- cli

aap_help() {
    cat <<EOF
ai-aligned-pkill $VERSION

GNU-semantics pkill and pgrep for coding agents on macOS. Installed as pkill
and pgrep earlier on PATH; humans get /usr/bin/pkill and /usr/bin/pgrep
untouched, so there is nothing to teach the agent.

For agents:
  * options may come before or after the pattern, as on Linux:
      pkill -f "node server.mjs" -n     (newest match, not "or '-n'")
      pkill node -9                     (signal anywhere)
  * exactly one pattern is allowed; use 'a|b' for alternatives
  * pgrep -a, -c, -l, -d and pkill -e, -c, --signal behave like procps
  * pkill signals only processes in the agent's own session, or orphans;
    anything belonging to an app, the system, a terminal session or another
    agent is refused, as is a match larger than \$AI_ALIGNED_PKILL_MAX
  * pkill -v is refused

  ai-aligned-pkill check <pkill args>  what pkill would signal, and why
  ai-aligned-pkill log [N]             the last N decisions (default 20)
  ai-aligned-pkill doctor              environment check
  ai-aligned-pkill version

Environment:
  AI_ALIGNED_PKILL_MAX=<n>            blast-radius cap (default 10)
  AI_ALIGNED_PKILL_PROTECT=<a:b>      extra protected path prefixes
  AI_ALIGNED_PKILL_HARNESSES="pi …"   argv[0] names of agent harnesses
  AI_ALIGNED_PKILL_DISABLE=true       pass everything through untouched
  AI_ALIGNED_PKILL_DEBUG=true         trace decisions to stderr
EOF
}

aap_cli() {
    local cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        check)
            aap_shim_pkill 1 "$(aap_agent)" "$@" ;;
        log)
            local n="${1:-20}"
            [ -r "$AAP_LOG" ] || { echo "(no decisions logged yet)"; return 0; }
            tail -n "$n" "$AAP_LOG" | awk -F'\t' '{ printf "%s  %-8s %-24s %s\n    cwd: %s\n    cmd: %s %s\n    pids: %s\n", $1, $2, $4, "", $5, $3, $6, $7 }' ;;
        doctor)
            echo "ai-aligned-pkill $VERSION"
            echo "  state dir    : $AAP_HOME"
            echo "  detected as  : $(aap_agent)"
            echo "  real pkill   : $([ -x "$AAP_REAL_PKILL" ] && echo "$AAP_REAL_PKILL" || echo MISSING)"
            echo "  real pgrep   : $([ -x "$AAP_REAL_PGREP" ] && echo "$AAP_REAL_PGREP" || echo MISSING)"
            echo "  pkill on PATH: $(command -v pkill)"
            echo "  pgrep on PATH: $(command -v pgrep)"
            echo "  cap          : $AAP_MAX"
            echo "  decisions    : $( [ -r "$AAP_LOG" ] && grep -c . "$AAP_LOG" || echo 0) logged" ;;
        version|--version|-V)
            echo "ai-aligned-pkill $VERSION" ;;
        *)
            aap_help ;;
    esac
}

# ---------------------------------------------------------------- entry point

INVOKED_AS="$(basename "$0")"
# Running the file in place, before install.sh strips the prefix.
INVOKED_AS="${INVOKED_AS#executable_}"

aap_real() {
    case "$1" in
        pkill) printf '%s' "$AAP_REAL_PKILL" ;;
        pgrep) printf '%s' "$AAP_REAL_PGREP" ;;
        *) return 1 ;;
    esac
}

if [ "$AAP_DISABLE" = "true" ]; then
    case "$INVOKED_AS" in
        pkill|pgrep) exec "$(aap_real "$INVOKED_AS")" "$@" ;;
    esac
fi

case "$INVOKED_AS" in
    pkill|pgrep)
        AAP_AGENT="$(aap_agent)"
        if [ "$AAP_AGENT" = "none" ]; then
            aap_debug "no agent detected, passing through"
            exec "$(aap_real "$INVOKED_AS")" "$@"
        fi
        aap_debug "agent: $AAP_AGENT"
        if [ "$INVOKED_AS" = pgrep ]; then
            aap_shim_pgrep "$AAP_AGENT" "$@"
        else
            aap_shim_pkill 0 "$AAP_AGENT" "$@"
        fi
        exit $? ;;
    ai-aligned-pkill)
        aap_cli "$@"; exit $? ;;
    *)
        echo "ai-aligned-pkill: unknown invocation '$INVOKED_AS'" >&2; exit 127 ;;
esac
