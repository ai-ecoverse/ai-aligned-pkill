#!/bin/bash
#
# ai-aligned-pkill - GNU-semantics pkill/pgrep for coding agents on macOS
#
# Installed as pkill and pgrep earlier on PATH than /usr/bin. When the caller
# is a coding agent it:
#
#   1. Parses the command line the way GNU procps does — options may follow the
#      pattern, exactly one pattern is allowed — and hands BSD pkill/pgrep a
#      command line it reads the same way. macOS stops option parsing at the
#      first operand, so `pkill -f "node server.mjs" -n` there means "anything
#      matching 'node server.mjs' OR '-n'", and "-n" occurs in the arguments of
#      most of the GUI apps, Electron helpers and login shells on the machine.
#   2. Vets every match before signalling it, and refuses the whole command
#      (signalling nothing) if any match is outside the agent's own session:
#      app bundles, system processes, terminal sessions, other agents.
#   3. Refuses matches larger than a blast-radius cap (default 10).
#   4. Signals exactly the PIDs it vetted, and logs what it did.
#
# Humans get an untouched pass-through.
#
# See: https://github.com/ai-ecoverse/ai-aligned-pkill

VERSION="0.1.0"

# ---------------------------------------------------------------- configuration

AAP_HOME="${AI_ALIGNED_PKILL_HOME:-$HOME/.ai-aligned-pkill}"
AAP_CACHE="$AAP_HOME/cache"
AAP_LOG="$AAP_HOME/log.tsv"

# Refuse a pkill that matches more processes than this.
AAP_MAX="${AI_ALIGNED_PKILL_MAX:-10}"
# Set to "true" to pass everything through untouched.
AAP_DISABLE="${AI_ALIGNED_PKILL_DISABLE:-false}"
# Extra colon-separated path prefixes whose processes an agent may not signal.
AAP_PROTECT_EXTRA="${AI_ALIGNED_PKILL_PROTECT:-}"
# argv[0] basenames that identify a coding-agent harness process.
AAP_HARNESSES="${AI_ALIGNED_PKILL_HARNESSES:-pi claude codex gemini droid auggie cursor-agent amp opencode goose crush aider qwen copilot kimi grok kiro cline}"

AAP_REAL_PKILL="/usr/bin/pkill"
AAP_REAL_PGREP="/usr/bin/pgrep"

DEBUG="${AI_ALIGNED_PKILL_DEBUG:-false}"

aap_debug() {
    [ "$DEBUG" = "true" ] && echo "[ai-aligned-pkill] $*" >&2
    return 0
}

# Corrective notices go to stderr so they land in the agent's tool output
# without polluting stdout, which callers parse.
aap_notice() {
    echo "ai-aligned-pkill: $*" >&2
}

# am-i-ai's bundler deliberately strips _ami_debug, so the consuming script
# must supply it.
_ami_debug() {
    [ "${AMI_DEBUG:-}" = "true" ] && echo "[am-i-ai] $*" >&2
    return 0
}

