# Get the display name for a detected AI tool
# Arguments: $1 = AI tool name (optional, uses ami_detect if not provided)
ami_get_name() {
    local tool="${1:-$(ami_detect)}"

    case "$tool" in
        "claude")   echo "Claude Code" ;;
        "gemini")   echo "Gemini" ;;
        "codex")    echo "Codex" ;;
        "aider")    echo "Aider" ;;
